                                            <img src="images/multiple-use/side-navmenu/side-logo.png" class="img-fluid"
                                                 alt="">
                                        </a>
                                        <a href="#" class="closebtn" onclick="closeNav()">&times;</a>
                                    </div>
                                    <div class="our-mission ">
