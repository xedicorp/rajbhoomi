
@{
    ViewData["Title"] = "Contact Rajbhoomi – Book Your Site Visit Today";
    ViewData["MetaDescription"] = "Get in touch with Rajbhoomi for premium plots and township projects. Book a free consultation or schedule your site visit today.";
    ViewData["Keywords"] = "contact real estate company, book site visit plots, real estate consultation";
}

<!-- =====main section===== -->
<div class="contact">
    <!-- =====Banner Section===== -->
    <div class="banner">
        <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="images-optimization position-relative ">
                        <img src="~/images/others/newimg7.webp" class="d-block img-fluid " alt="...">
                        <div class="cover-images-overlay">
                            <div class="container">
                                <div class="banner-content ">
                                    <h4 class="text-white">Get in touch with us</h4>
                                    <h1 class="text-white text-uppercase  my-3">Contact</h1>
                                </div>
                                <div class="home-about-link">
                                    <ul>
                                        <li><a class="text-white" href="@Url.Action("Index", "Home")">Home</a></li>
                                        <li class="text-white"> / </li>
                                        <li>
                                            <a class="text-white" href="@Url.Action("Contact", "Home")">Contact</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
    <!-- =====Contact section===== -->
    <section data-aos="fade-up">
        <div class="container">
            <div class="contact-information">
                <div class="row align-items-center g-5">
                    <div class="col-md-12 col-lg-4 col-xl-4 contact-info py-5 px-4" data-aos="fade-right">
                        <h2>Contact Information</h2>
                        <div class="info-item d-flex align-items-center">
                            <div class="contact-icon"><i class="bi bi-geo-alt"></i></div>
                            <div>
                                <p>Address</p>
                                <span>Vande Mataram Marg, Mansarovar, Jaipur, Rajasthan 302020</span>
                            </div>
                        </div>
                        <div class="info-item d-flex align-items-center">
                            <div class="contact-icon">
                                <i class="bi bi-telephone phone"></i>
                            </div>
                            <div>
                                <p>Contact Number</p>
                                <span>
                                    <a href="tel:+123456987">
                                        +111 1111 1234
                                    </a>
                                </span>
                            </div>
                        </div>
                        <div class="info-item d-flex align-items-center">
                            <div class="contact-icon">
                                <i class="bi bi-envelope email"></i>
                            </div>
                            <div>
                                <p>Email Us</p>
                                <span>
                                    <a href="mailto:rajbhoomi@gmail.com">
                                        rajbhoomi@gmail.com
                                    </a>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 col-lg-8 col-xl-8 get-quote" data-aos="fade-left">
                        <h2>Get A Quote</h2>
                        <form id="contactForm">
                            <div class="two-group d-flex gap-3 my-3">
                                <div class="form-group">
                                    <label for="name">Your Name</label>
                                    <input type="text" class="form-control" id="name" placeholder="Your Name">
                                </div>
                                <div class="form-group">
                                    <label for="email">Email Address</label>
                                    <input type="email" class="form-control" id="email" placeholder="Email Address">
                                </div>
                            </div>
                            <div class="two-group d-flex gap-3 my-3">
                                <div class="form-group">
                                    <label for="phone">Phone Number</label>
                                    <input type="tel" class="form-control" id="phone" placeholder="Phone Number">
                                </div>
                                <div class="form-group">
                                    <label for="subject">Subject</label>
                                    <input type="text" class="form-control" id="subject" placeholder="Subject">
                                </div>
                            </div>
                            <div class="form-group my-3">
                                <label for="company">Your Company Name</label>
                                <input type="text" class="form-control" id="company"
                                       placeholder="Your Company Name">
                            </div>
                            <div class="form-group my-3">
                                <label for="message">Write your question here</label>
                                <textarea class="form-control" id="message" rows="4"
                                          placeholder="Write your question here"></textarea>
                            </div>
                            <div class="cityWall-btn mt-4">
                                <button type="submit" class="text-white">Get Started</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
   
</div>
