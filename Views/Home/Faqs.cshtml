
@{
    ViewData["Title"] = "Faqs";
}

<div class="projects-details">
    <!-- =====Banner Section===== -->
    <div class="banner">
        <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="images-optimization position-relative ">
                        <img src="~/images/others/newimg8.webp" class="d-block img-fluid " alt="...">
                        <div class="cover-images-overlay">
                            <div class="container">
                                <div class="banner-content ">
                                    <h4 class="text-white">Common Questions and Answers</h4>
                                        <h1 class="text-white text-uppercase  my-3">Frequently Asked Questions</h1>
                                </div>
                                <div class="home-about-link">
                                    <ul>
                                        <li><a class="text-white" href="@Url.Action("Index", "Home")">Home</a></li>
                                        <li class="text-white"> / </li>
                                        <li>
                                                <a class="text-white" href="@Url.Action("Faqs", "Home")">Frequently Asked Questions</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            
            </div>
        </div>
    </div>
    <!-- FAQ Page -->
    <section class="faq-page" data-aos="fade-up">
        <div class="container">
            <div class="accordion" id="accordionExample">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button ps-3" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                Are plots available for sale in this township?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                                Yes, residential plots are available for sale within the township. These plots are suitable for both home construction and long-term property investment.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                Is this a good option for property investment?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                                This project is located in a developing area, which makes it a practical choice for those looking at property investment with future growth potential.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                Can I build a house on the plot immediately?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                                Yes, the plots are planned with proper layout and access, so buyers can start construction based on their requirements and approvals.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                What basic facilities are available in the township?
                        </button>
                    </h2>
                    <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                                The township includes internal roads, open areas, and essential infrastructure needed for comfortable living in a residential plot project.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                                Is the project suitable for residential use?
                        </button>
                    </h2>
                    <div id="collapseFive" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                                Yes, the project is designed for residential use and is suitable for families planning to build a home in a planned township.
                        </div>
                    </div>
                </div>
                    
                
                <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
                                How is the connectivity of the location?
                            </button>
                        </h2>
                        <div id="collapseSix" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                The township is connected to nearby areas of Jaipur, making daily travel and access to essential services manageable.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapseSeven" aria-expanded="false" aria-controls="collapseSeven">
                                Is documentation clear for buying plots?
                            </button>
                        </h2>
                        <div id="collapseSeven" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                Yes, proper documentation is maintained to ensure a smooth and transparent process for buyers looking to purchase plots.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapseEight" aria-expanded="false" aria-controls="collapseEight">
                                What makes this township different from other plot projects?
                            </button>
                        </h2>
                        <div id="collapseEight" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                The focus is on proper planning, usable land, and a straightforward buying process, rather than just selling plotted land.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapseNine" aria-expanded="false" aria-controls="collapseNine">
                                Are these plots suitable for long-term investment?
                            </button>
                        </h2>
                        <div id="collapseNine" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                Yes, these residential plots are suitable for long-term investment, especially for buyers looking for land with future value.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed ps-3" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapseTen" aria-expanded="false" aria-controls="collapseTen">
                                How can I book or visit the site?
                            </button>
                        </h2>
                        <div id="collapseTen" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                You can contact the team to schedule a site visit and get complete details before making a decision to buy a plot.
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </section>
</div>

